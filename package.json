{
  "name": "tactics-game",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
