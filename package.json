{
  "name": "tactics-game",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "version:check": "node scripts/check-version-change.mjs",
    "verify": "npm run check && npm test && npm run build && npm run version:check",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "7.3.7"
  }
}
